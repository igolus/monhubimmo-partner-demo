# MonHubImmo Partner Demo - Environment Variables

# API Configuration
NEXT_PUBLIC_API_URL=https://monhubimmo-api.onrender.com

# Partner API Key (get this from your MonHubImmo partner dashboard)
NEXT_PUBLIC_PARTNER_API_KEY=your_partner_api_key_here

# JWT Secret (get this from your MonHubImmo partner dashboard - for SSO login)
NEXT_PUBLIC_JWT_SECRET=your_jwt_secret_here
